# Copy to .env and fill in. Never commit .env.

AEGIS_ENV=development

# Safe defaults. Live trading is not available in this build.
AEGIS_SYSTEM_MODE=research            # research | paper | live
AEGIS_LIVE_TRADING_ENABLED=false      # true is only accepted with AEGIS_SYSTEM_MODE=live
AEGIS_DEMO_DATA=false                 # never allowed with live mode or in production

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AEGIS_JWT_SECRET=
AEGIS_TOKEN_MINUTES=60
AEGIS_CORS_ORIGINS=["http://localhost:3000"]

POSTGRES_PASSWORD=
# Only needed when running the backend outside docker compose:
DATABASE_URL=postgresql+psycopg://aegis:<password>@localhost:5432/aegis
REDIS_URL=redis://localhost:6379/0

# Optional: LLM narrator for analysis reports (prose only; numbers are
# validated against the deterministic facts). Leave empty to disable.
AEGIS_LLM_API_KEY=
AEGIS_LLM_MODEL=claude-sonnet-4-5

# Optional alert channels (Phase 12). In-app alerts always work. Enable a
# channel in config/aegis.yaml (alerts.*_enabled) AND set its variables.
AEGIS_TELEGRAM_BOT_TOKEN=
AEGIS_TELEGRAM_CHAT_ID=
AEGIS_SMTP_URL=                        # smtp://user:pass@host:587 (STARTTLS) or smtps://...:465
AEGIS_ALERT_EMAIL_TO=
AEGIS_ALERT_EMAIL_FROM=aegis@localhost

# ---- Production (docker-compose.prod.yml) ----------------------------------
# Startup refuses AEGIS_ENV=production unless every item below is safe. Check
# first with: docker compose ... run --rm backend python -m app.cli check-deploy
# AEGIS_ENV=production
# AEGIS_UI_HOST=aegis.example.in
# AEGIS_API_HOST=api.aegis.example.in
# AEGIS_CORS_ORIGINS=["https://aegis.example.in"]
# AEGIS_ALLOWED_HOSTS=["api.aegis.example.in"]
# AEGIS_JWT_SECRET=                     # >= 48 chars: python -c "import secrets; print(secrets.token_urlsafe(48))"
# POSTGRES_PASSWORD=                    # strong, not a default
# REDIS_PASSWORD=                       # strong; REDIS_URL is built from it
# AEGIS_TOKEN_MINUTES=30                # <= 60
